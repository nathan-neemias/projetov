# Sem DOMAIN: atende HTTP na porta 80 (acesso pelo IP).
# Com DOMAIN: obtém e renova o certificado HTTPS sozinho (o domínio precisa apontar para este servidor).
{$DOMAIN::80} {
	encode zstd gzip
	reverse_proxy app:8080 {
		flush_interval -1
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
