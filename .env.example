# ===== Projeto V: configuração =====
# Copie para .env e ajuste. O deploy.sh cria o .env e gera o JWT_SECRET sozinho.

# Segredo das sessões de login (obrigatório, mínimo 32 caracteres). Gere com: openssl rand -hex 32
JWT_SECRET=

# Coach de IA (opcional, mas é o que deixa o sistema "inteligente"). Chave em console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Limite de perguntas ao coach por usuário por dia (controla o custo)
COACH_DAILY_LIMIT=60

# Domínio para HTTPS automático (ex.: treino.seudominio.com.br). Deixe vazio para usar só HTTP pelo IP.
DOMAIN=
# true quando houver HTTPS (com DOMAIN preenchido). Com false o login funciona por HTTP, mas sem a proteção do cookie seguro.
COOKIE_SECURE=false

# Depois de criar sua conta, coloque false para impedir novos cadastros.
ALLOW_REGISTRATION=true
