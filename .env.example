# ===== Projeto V: configuração =====
# Copie para .env e ajuste. O deploy.sh cria o .env sozinho.

# Segredo das sessões de login (obrigatório, mínimo 32 caracteres). Gere com: openssl rand -hex 32
JWT_SECRET=

# Senha do PostgreSQL (obrigatória). O deploy.sh gera uma aleatória.
POSTGRES_PASSWORD=

# Coach de IA (opcional). Chave em console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
COACH_DAILY_LIMIT=60

# Domínio para HTTPS automático via Caddy (--profile with-caddy). Deixe vazio se usar só IP:8080.
DOMAIN=
COOKIE_SECURE=false

# Depois de criar sua conta, coloque false para impedir novos cadastros.
ALLOW_REGISTRATION=true
